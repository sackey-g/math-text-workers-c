{
  "name": "kawaijuku-math-latter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate_data.js && next dev",
    "prebuild": "node scripts/validate_data.js && node scripts/generate_data.js",
    "build": "next build",
    "start": "wrangler dev",
    "preview": "node scripts/validate_data.js && node scripts/generate_data.js && next build && wrangler dev",
    "deploy": "node scripts/validate_data.js && node scripts/generate_data.js && next build && wrangler deploy",
    "lint": "eslint .",
    "format:data": "node scripts/format_data.js",
    "validate:data": "node scripts/validate_data.js",
    "check": "eslint . && node scripts/validate_data.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.16.45",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.127.1"
  }
}
